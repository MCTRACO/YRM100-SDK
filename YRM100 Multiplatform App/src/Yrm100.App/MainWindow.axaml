<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yrm100.App.MainWindow">
  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18" MinWidth="320">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="YRM1002 FIELD SCAN" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="RFID tag radar" Opacity="0.6" />
        </StackPanel>
        <Border Grid.Column="1" Background="#DDF7E6" CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
          <TextBlock Name="StatusText" Text="DISCONNECTED" Foreground="#176B3A" FontSize="11" FontWeight="Bold" />
        </Border>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
        <ComboBox Name="PortBox" MinWidth="120" HorizontalAlignment="Stretch" />
        <Button Grid.Column="1" Content="Refresh" Click="RefreshPorts" Margin="8,0,0,0" />
        <Button Grid.Column="2" Content="Connect" Click="Connect" Margin="8,0,0,0" />
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="1.2*,*" RowDefinitions="Auto,*">
        <Border Background="#101820" CornerRadius="12" Padding="12" MinHeight="310">
          <Canvas Name="RadarCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Ellipse Width="260" Height="260" Stroke="#2A5360" StrokeThickness="1" />
            <Ellipse Width="190" Height="190" Stroke="#2A5360" StrokeThickness="1" Canvas.Left="35" Canvas.Top="35" />
            <Ellipse Width="120" Height="120" Stroke="#2A5360" StrokeThickness="1" Canvas.Left="70" Canvas.Top="70" />
            <Line StartPoint="130,0" EndPoint="130,260" Stroke="#1D3C46" />
            <Line StartPoint="0,130" EndPoint="260,130" Stroke="#1D3C46" />
            <Ellipse Width="8" Height="8" Fill="#78F2A5" Canvas.Left="126" Canvas.Top="126" />
            <Canvas Name="TagDots" />
          </Canvas>
        </Border>
        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Text="SELECTED TAG" FontSize="12" FontWeight="Bold" Opacity="0.6" />
          <TextBlock Name="EpcText" Text="No tag detected" FontFamily="monospace" TextWrapping="Wrap" />
          <TextBlock Name="CrcText" Text="CRC: -" />
          <TextBlock Name="RssiText" Text="RSSI: -" />
          <TextBlock Name="CountText" Text="0 tags in sweep" Opacity="0.65" />
          <Separator Margin="0,6" />
          <TextBlock Text="READER" FontSize="12" FontWeight="Bold" Opacity="0.6" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Scan" Click="StartInventory" />
            <Button Content="Read once" Click="ReadOnce" />
            <Button Content="Stop" Click="StopInventory" />
          </StackPanel>
          <TextBlock Text="Access password (8 hex)" FontSize="12" />
          <TextBox Name="AccessPasswordBox" Text="00000000" />
          <Button Content="Write blank USER data" Click="WriteBlank" />
          <TextBlock Text="Kill password (8 hex)" FontSize="12" />
          <TextBox Name="KillPasswordBox" Text="0000FFFF" />
          <Button Content="Kill selected tag" Click="KillTag" Background="#B3261E" Foreground="White" />
        </StackPanel>
      </Grid>
      <TextBlock Grid.Row="3" Name="LogText" Text="Connect a USB reader to begin." TextWrapping="Wrap" Margin="0,14,0,0" Opacity="0.75" />
    </Grid>
  </ScrollViewer>
</UserControl>
